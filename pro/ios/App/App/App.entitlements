<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal Links. Sans cet entitlement, l'app Pro ne pouvait revendiquer
	     AUCUNE URL de yunoapp.eu : une invitation de videur envoyée par email
	     ouvrait l'app CLIENT, qui n'a ni code PIN ni scan. Le fichier
	     public/.well-known/apple-app-site-association lui attribue les chemins
	     staff/pro ; cet entitlement est l'autre moitié du contrat, et il vit
	     dans le BINAIRE — il n'arrive donc jamais par OTA. Prérequis côté
	     Apple : la capacité « Associated Domains » activée sur l'App ID
	     eu.yunoapp.pro, sinon la signature échoue. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:yunoapp.eu</string>
		<string>webcredentials:yunoapp.eu</string>
	</array>
</dict>
</plist>
